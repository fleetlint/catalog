{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":semanticCommits",
    "customManagers:makefileVersions",
    "customManagers:githubActionsVersions"
  ],
  "pre-commit": {
    "enabled": true,
    "managerFilePatterns": [
      "/^templates/pre-commit/.+\\.ya?ml$/"
    ]
  },
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "github-actions": {
    "managerFilePatterns": [
      "/^templates/.+\\.ya?ml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Version variables with a `# renovate:` comment in the fix templates",
      "managerFilePatterns": [
        "/^templates/.+$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-.]+?) depName=(?<depName>[^\\s]+?)(?: versioning=(?<versioning>[^\\s]+?))?\\s+[A-Za-z0-9_]+?_VERSION\\s*(?::|\\??=)\\s*[\"']?(?<currentValue>[^\\s\"']+)"
      ]
    }
  ]
}
