<?xml version="1.0"?>
<!DOCTYPE module PUBLIC "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN" "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!-- Checkstyle configuration (see https://fleetlint.org/stacks/#java). Written by fleetlint fix; adjust freely.
     Wire it with maven-checkstyle-plugin (configLocation config/checkstyle/checkstyle.xml, failOnViolation true). -->
<module name="Checker">
  <property name="severity" value="error"/>
  <module name="FileLength"><property name="max" value="800"/></module>
  <module name="LineLength"><property name="max" value="120"/></module>
  <module name="NewlineAtEndOfFile"/>
  <module name="TreeWalker">
    <module name="EmptyCatchBlock"><property name="exceptionVariableName" value="expected|ignored"/></module>
    <module name="IllegalCatch"/>
    <module name="IllegalThrows"/>
    <module name="MethodLength"><property name="max" value="50"/></module>
    <module name="CyclomaticComplexity"><property name="max" value="15"/></module>
    <module name="ParameterNumber"><property name="max" value="6"/></module>
    <module name="NestedIfDepth"><property name="max" value="3"/></module>
    <module name="MissingSwitchDefault"/>
    <module name="FallThrough"/>
    <module name="EqualsHashCode"/>
    <module name="UnusedImports"/>
    <module name="AvoidStarImport"/>
    <module name="TodoComment">
      <property name="format" value="(TODO|FIXME)(?!\(#\d+\))"/>
      <message key="todo.match" value="a TODO or FIXME needs an issue reference, e.g. TODO(#123)"/>
    </module>
    <module name="SuppressWarnings"><property name="format" value="^$"/></module>
    <module name="SuppressWarningsHolder"/>
  </module>
  <module name="SuppressWarningsFilter"/>
</module>
