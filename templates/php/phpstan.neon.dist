# PHPStan configuration (see https://fleetlint.org/stacks/#php). Written by fleetlint fix; adjust freely.
# Composer: phpstan/phpstan, phpstan/phpstan-strict-rules. Ratchet with a baseline: vendor/bin/phpstan analyse --generate-baseline.
includes:
  - vendor/phpstan/phpstan-strict-rules/rules.neon

parameters:
  level: max
  # Every listed path must exist; add tests (and other source roots) here.
  paths:
    - src
  treatPhpDocTypesAsCertain: false
  reportUnmatchedIgnoredErrors: true
